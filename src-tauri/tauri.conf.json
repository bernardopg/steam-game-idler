{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Game Idler",
  "mainBinaryName": "Steam Game Idler",
  "version": "5.0.20",
  "identifier": "com.github.bernardopg.SteamGameIdler",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../out"
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "Copyright © 2024-2026 zevnda; fork © 2025-2026 Bernardo Pinto Gomes",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    },
    "longDescription": "Idle any game in your Steam library",
    "shortDescription": "Steam Game Idler",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": ["libs/*", "LICENSE", ".installed"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libssl3", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "licenseFile": "LICENSE",
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRERCMDNBMzM4NEVGM0MKUldRODc0UXpPckRkRWI0WUVLeTdub2pldURibitFV2VHa3drSHc0cE40WkdVR0l5WmdZMS80R1MK",
      "endpoints": [
        "https://raw.githubusercontent.com/bernardopg/steam-game-idler/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Steam Game Idler",
        "width": 1440,
        "height": 850,
        "minWidth": 1440,
        "minHeight": 850,
        "fullscreen": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
